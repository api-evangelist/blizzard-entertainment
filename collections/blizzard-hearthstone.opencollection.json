{
  "opencollection": "1.0.0",
  "info": {
    "name": "Hearthstone Game Data API",
    "version": "1.0"
  },
  "request": {
    "auth": {
      "type": "bearer",
      "token": "{{bearerToken}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "Cards",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Search Cards",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://us.api.blizzard.com/hearthstone/cards",
            "params": [
              {
                "name": "set",
                "value": "",
                "type": "query"
              },
              {
                "name": "class",
                "value": "",
                "type": "query"
              },
              {
                "name": "manaCost",
                "value": "",
                "type": "query"
              },
              {
                "name": "locale",
                "value": "",
                "type": "query"
              }
            ]
          },
          "docs": "Returns a list of cards matching the supplied filters."
        },
        {
          "info": {
            "name": "Get Card",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://us.api.blizzard.com/hearthstone/cards/:idOrSlug",
            "params": [
              {
                "name": "idOrSlug",
                "value": "",
                "type": "path"
              },
              {
                "name": "locale",
                "value": "",
                "type": "query"
              }
            ]
          },
          "docs": "Returns a single Hearthstone card by id or slug."
        }
      ]
    },
    {
      "info": {
        "name": "Card Backs",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Search Card Backs",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://us.api.blizzard.com/hearthstone/cardbacks",
            "params": [
              {
                "name": "locale",
                "value": "",
                "type": "query"
              }
            ]
          },
          "docs": "Returns a list of card backs matching the supplied filters."
        }
      ]
    },
    {
      "info": {
        "name": "Decks",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Get Deck",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://us.api.blizzard.com/hearthstone/deck",
            "params": [
              {
                "name": "code",
                "value": "",
                "type": "query",
                "description": "Hearthstone deck code."
              },
              {
                "name": "locale",
                "value": "",
                "type": "query"
              }
            ]
          },
          "docs": "Returns the deck represented by a Hearthstone deck code."
        }
      ]
    },
    {
      "info": {
        "name": "Metadata",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Get Metadata",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://us.api.blizzard.com/hearthstone/metadata",
            "params": [
              {
                "name": "locale",
                "value": "",
                "type": "query"
              }
            ]
          },
          "docs": "Returns Hearthstone metadata reference data (sets, classes, etc.)."
        }
      ]
    }
  ],
  "bundled": true
}