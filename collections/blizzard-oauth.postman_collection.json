  "info": {
    "_postman_id": "1237ba7b-c49f-4fd7-a6b0-bc79c753a5bc",
    "name": "Battle.net OAuth API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": {
      "content": "OAuth 2.0 authorization server for the Battle.net developer platform. Supports the authorization code flow (with PKCE) for user-context access to Battle.net account and profile scopes, and the client credentials flow for accessing public Game Data APIs. Hosted at https://oauth.battle.net.\n\nContact Support:\n Name: Battle.net Developer Portal",
      "type": "text/plain"
    }
  }
