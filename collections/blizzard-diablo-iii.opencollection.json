{
  "opencollection": "1.0.0",
  "info": {
    "name": "Diablo III Community API",
    "version": "1.0"
  },
  "request": {
    "auth": {
      "type": "bearer",
      "token": "{{bearerToken}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "Acts",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Get Act Index",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://us.api.blizzard.com/d3/data/act",
            "params": [
              {
                "name": "locale",
                "value": "",
                "type": "query",
                "description": "Locale used for localized fields (e.g. en_US)."
              }
            ]
          },
          "docs": "Returns an index of Diablo III acts."
        }
      ]
    },
    {
      "info": {
        "name": "Artisans",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Get Artisan",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://us.api.blizzard.com/d3/data/artisan/:artisanSlug",
            "params": [
              {
                "name": "artisanSlug",
                "value": "",
                "type": "path"
              },
              {
                "name": "locale",
                "value": "",
                "type": "query",
                "description": "Locale used for localized fields (e.g. en_US)."
              }
            ]
          },
          "docs": "Returns an artisan by slug."
        }
      ]
    },
    {
      "info": {
        "name": "Characters",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Get Character Class",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://us.api.blizzard.com/d3/data/hero/:classSlug",
            "params": [
              {
                "name": "classSlug",
                "value": "",
                "type": "path"
              },
              {
                "name": "locale",
                "value": "",
                "type": "query",
                "description": "Locale used for localized fields (e.g. en_US)."
              }
            ]
          },
          "docs": "Returns a Diablo III character class by slug."
        }
      ]
    },
    {
      "info": {
        "name": "Items",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Get Item Type Index",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://us.api.blizzard.com/d3/data/item-type",
            "params": [
              {
                "name": "locale",
                "value": "",
                "type": "query",
                "description": "Locale used for localized fields (e.g. en_US)."
              }
            ]
          },
          "docs": "Returns an index of item types."
        }
      ]
    },
    {
      "info": {
        "name": "Profiles",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Get Api Account",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://us.api.blizzard.com/d3/profile/:accountId/",
            "params": [
              {
                "name": "accountId",
                "value": "",
                "type": "path",
                "description": "Battle.net account id in the form name-tag."
              },
              {
                "name": "locale",
                "value": "",
                "type": "query",
                "description": "Locale used for localized fields (e.g. en_US)."
              }
            ]
          },
          "docs": "Returns a player's full Diablo III career profile."
        },
        {
          "info": {
            "name": "Get Api Hero",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://us.api.blizzard.com/d3/profile/:accountId/hero/:heroId",
            "params": [
              {
                "name": "accountId",
                "value": "",
                "type": "path"
              },
              {
                "name": "heroId",
                "value": "",
                "type": "path"
              },
              {
                "name": "locale",
                "value": "",
                "type": "query",
                "description": "Locale used for localized fields (e.g. en_US)."
              }
            ]
          },
          "docs": "Returns a single hero from a player's Diablo III career."
        }
      ]
    }
  ],
  "bundled": true
}