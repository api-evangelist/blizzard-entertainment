  "info": {
    "_postman_id": "b68de56c-5e5c-4f78-b980-48d27445e2e0",
    "name": "World of Warcraft Game Data API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": {
      "content": "Battle.net Game Data API for World of Warcraft providing read-only access to achievements, auctions, characters, guilds, items, mounts, pets, PvP seasons, realms, and regions. Requires an OAuth 2.0 client credentials access token from https://oauth.battle.net. Namespaces (static, dynamic, profile) are passed as the `namespace` query parameter to select the data set.\n\nContact Support:\n Name: Battle.net Developer Portal",
      "type": "text/plain"
    }
  }
