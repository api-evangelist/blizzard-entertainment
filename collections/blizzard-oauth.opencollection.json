{
  "opencollection": "1.0.0",
  "info": {
    "name": "Battle.net OAuth API",
    "version": "1.0"
  },
  "items": [
    {
      "info": {
        "name": "Authorization",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Start Authorization Code Flow",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://oauth.battle.net/authorize",
            "params": [
              {
                "name": "client_id",
                "value": "",
                "type": "query"
              },
              {
                "name": "response_type",
                "value": "",
                "type": "query"
              },
              {
                "name": "scope",
                "value": "",
                "type": "query"
              },
              {
                "name": "redirect_uri",
                "value": "",
                "type": "query"
              },
              {
                "name": "state",
                "value": "",
                "type": "query"
              }
            ]
          },
          "docs": "Redirects the user to the Battle.net consent screen and returns an authorization code on success."
        }
      ]
    },
    {
      "info": {
        "name": "Token",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Create Token",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://oauth.battle.net/token",
            "body": {
              "type": "form-urlencoded",
              "data": [
                {
                  "name": "grant_type",
                  "value": ""
                },
                {
                  "name": "code",
                  "value": ""
                },
                {
                  "name": "redirect_uri",
                  "value": ""
                },
                {
                  "name": "client_id",
                  "value": ""
                },
                {
                  "name": "client_secret",
                  "value": ""
                },
                {
                  "name": "refresh_token",
                  "value": ""
                }
              ]
            }
          },
          "docs": "Exchanges an authorization code or client credentials for an access token."
        },
        {
          "info": {
            "name": "Check Token",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://oauth.battle.net/oauth/check_token",
            "body": {
              "type": "form-urlencoded",
              "data": [
                {
                  "name": "token",
                  "value": ""
                }
              ]
            }
          },
          "docs": "Validates an access token and returns information about it."
        }
      ]
    },
    {
      "info": {
        "name": "UserInfo",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Get User Info",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://oauth.battle.net/oauth/userinfo",
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "Returns the Battle.net account id, battletag, and sub claim for the authenticated user."
        }
      ]
    }
  ],
  "bundled": true
}