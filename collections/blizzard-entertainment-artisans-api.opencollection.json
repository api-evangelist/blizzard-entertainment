{
  "opencollection": "1.0.0",
  "info": {
    "name": "Diablo III Community Achievements Artisans API",
    "version": "1.0"
  },
  "request": {
    "auth": {
      "type": "bearer",
      "token": "{{bearerToken}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "Artisans",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Get Artisan",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://us.api.blizzard.com/d3/data/artisan/:artisanSlug",
            "params": [
              {
                "name": "artisanSlug",
                "value": "",
                "type": "path"
              },
              {
                "name": "locale",
                "value": "",
                "type": "query",
                "description": "Locale used for localized fields (e.g. en_US)."
              }
            ]
          },
          "docs": "Returns an artisan by slug."
        }
      ]
    }
  ],
  "bundled": true
}